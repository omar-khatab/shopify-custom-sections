<div class="product-grid-section" id="product-grid-{{ section.id }}">
  <h3 class="wrapper-head">Tisso vison in the wild</h3>
  <div class="grid-wrapper">
   {% for block in section.blocks %}
    {% assign product = block.settings.product %}
    {%- comment -%}
      Product card block
      - Uses block.shopify_attributes for theme editor drag & drop support
    {%- endcomment -%}
    <div class="product-card" data-product-id="{{ product.id }}" {{ block.shopify_attributes }}>
      {% if product!= blank %}
        <div class="product-image">
          <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title }}" loading="lazy" width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}">
          <button class="circle-btn" aria-label="Open quick view">+</button>
        </div>
      {% else %}
        {%- comment -%} Editor placeholder: shown when merchant hasn't selected a product yet {%- endcomment -%}
        <div class="product-image" style="display:flex; align-items:center; justify-content:center; background:#f5f5f5; border:1px dashed #ccc; aspect-ratio:1;">
          <p style="font-family:Jost; font-size:14px; opacity:0.5;">Choose product</p>
        </div>
      {% endif %}
    </div>

    {% if product!= blank %}
      {%- comment -%}
        Store product data as JSON for JS consumption
      {%- endcomment -%}
      <script type="application/json" id="ProductJson-{{ product.id }}">
      {
        "title": {{ product.title | json }},
        "price_formatted": {{ product.price | money | json }},
        "image": {{ product.featured_image | image_url: width: 600 | json }},
        "description": {{ product.description | strip_html | truncate: 200 | json }},
        "variants": {{ product.variants | json }},
        "handle": {{ product.handle | json }},
        "options": [
          {% for opt in product.options_with_values %}
            {
              "name": {{ opt.name | json }},
              "position": {{ opt.position }},
              "values": {{ opt.values | json }}
            }{% unless forloop.last %},{% endunless %}
          {% endfor %}
        ]
      }
      </script>
    {% endif %}
   {% endfor %}
  </div>

{% assign soft_jacket = all_products['dark-winter-jacket'] %}
{% if soft_jacket!= blank %}
  {%- comment -%} Preload cross-sell product for Black + Medium auto-add promotion {%- endcomment -%}
  <script type="application/json" id="SoftJacketJson">
  {
    "id": {{ soft_jacket.id | json }},
    "title": {{ soft_jacket.title | json }},
    "variants": {{ soft_jacket.variants | json }}
  }
  </script>
{% endif %}
{% comment %} Popup , image + info on top {% endcomment %}
  <div class="popup-overlay" id="PopupOverlay-{{ section.id }}">
    <div class="popup-content" role="dialog" aria-modal="true">
      <button class="popup-close" aria-label="Close">&times;</button>
      <div class="popup-body">
        {% comment %} Top section: product image left + title/price/desc right {% endcomment %}
        <div class="popup-info">
          <img id="PopupImage-{{ section.id }}" src="" alt="" width="300" height="300">
          <div class="popup-text">
            <h2 id="PopupTitle-{{ section.id }}"></h2>
            <p id="PopupPrice-{{ section.id }}"></p>
            <div id="PopupDesc-{{ section.id }}"></div>
          </div>
        </div>
          {% comment %} Variants container - injected via JS but container exists in HTML for Figma CSS alignment {% endcomment %}
        <div id="PopupVariants-{{ section.id }}"></div>
      </div>
        {% comment %} Add to cart form - sends variant id + quantity to /cart/add.js {% endcomment %}
      <form id="PopupForm-{{ section.id }}" class="popup-form">
        <input type="hidden" id="PopupVariantId-{{ section.id }}" name="id" value="">
        <div class="popup-form-inputs">
          <input type="number" name="quantity" value="1" min="1">
          <button type="submit">Add to Cart</button>
        </div>
        <p id="PopupMessage-{{ section.id }}" class="message-form"></p>
      </form>
    </div>
  </div>

</div>

<style>
#product-grid-{{ section.id }} { padding: 40px 20px; }
#product-grid-{{ section.id }}  .wrapper-head { font-family: Lustria;font-size: 36px;line-height: 120%;margin-bottom: 30px;margin-top: 0;}
/* 3 columns grid on desktop */
#product-grid-{{ section.id }} .grid-wrapper {display: grid;grid-template-columns: repeat(3, 1fr);gap: 20px;max-width: 1400px;margin: 0 auto;}
#product-grid-{{ section.id }} .product-image { position: relative; background: #F5F5F5; aspect-ratio: 1; }
#product-grid-{{ section.id }} .product-image img { width: 100%; height: 100%; object-fit: cover;}
/* Circle button hidden by default, visible on hover */
#product-grid-{{ section.id }} .product-image .circle-btn {position: absolute;bottom: 15px; right: 15px;width: 38px; height: 38px;border-radius: 50%;background: #fff; color: #000;border: 1px solid #000;cursor: pointer;font-size: 20px;display: flex;align-items: center;justify-content: center;opacity: 0;transform: scale(0.8);transition: all 0.3s ease;pointer-events: none;}
#product-grid-{{ section.id }} .product-image:hover .circle-btn {opacity: 1;transform: scale(1);pointer-events: all;}

/* Mobile: 2 columns */
@media(max-width:768px){
  #product-grid-{{ section.id }} .grid-wrapper {grid-template-columns: repeat(2, 1fr);}
}

/* Popup overlay - hidden by default */
#product-grid-{{ section.id }} .popup-overlay {position: fixed; inset: 0;background: rgba(0,0,0,0.6);display: none;align-items: center; justify-content: center;z-index: 9999;}
#product-grid-{{ section.id }} .popup-overlay.show { display: flex; }

/* Popup card */
#product-grid-{{ section.id }} .popup-content {background: #fff; position: relative; padding: 20px;max-width: 350px;max-height: 447px;}
#product-grid-{{ section.id }} .popup-close {position: absolute; top: 10px; right: 10px;background: none; border: none; font-size: 30px; cursor: pointer;}
#product-grid-{{ section.id }} .popup-content.locked .popup-close { opacity: .3; cursor: not-allowed; }
#product-grid-{{ section.id }} .popup-body { display: flex; flex-direction: column; margin-bottom: 20px;}
#product-grid-{{ section.id }} .popup-body .popup-info {display: flex;gap: 5px;margin-top: 25px;align-items: center; }
#product-grid-{{ section.id }} .popup-body .popup-info img { width: 120px;height: 140px;object-fit: cover; }
#product-grid-{{ section.id }} .popup-body .popup-text { display: flex; flex-direction: column; gap: 5px; }
#product-grid-{{ section.id }} .popup-body .popup-text h2 { font-family: Lustria;font-size: 16px;line-height: 120%;margin: 0;}
#product-grid-{{ section.id }} .popup-body .popup-text p { font-family: Jost;font-weight: 300;font-style: Light;font-size: 14px; margin: 0;}
#product-grid-{{ section.id }} .popup-body .popup-text div {font-family: Jost;font-weight: 300;font-style: Light;font-size: 13px;line-height: 110%;}

/* Variants wrapper - reversed to show Color above Size per Figma layout */
#PopupVariants-{{ section.id }} {display: flex;flex-direction: column-reverse;gap: 5px;}

{% comment %} Variant row for Color option {% endcomment %}
#PopupVariants-{{ section.id }} .color {display: flex;position: relative;}
#PopupVariants-{{ section.id }} .color .active-element{position: absolute;width:50%;height:100%;background:#000;transition:0.5s;z-index:1;opacity: 0;}
#PopupVariants-{{ section.id }} .color button {position:relative;flex:1; border:1px solid #222;padding: 10px;text-align: left;background:transparent;color:#000;z-index:2;transition:0.3s;cursor:pointer;}
#PopupVariants-{{ section.id }} .color button.active {color:#fff}

/* ============================================
  Custom Select - Size Variant (Figma spec)
  Replaces native <select> for consistent styling
  ============================================ */

/* Container - relative for absolute dropdown positioning */
#PopupVariants-{{ section.id }} .custom-select {position: relative;width: 100%;}
/* Trigger - visible button that shows current selection */
#PopupVariants-{{ section.id }} .select-trigger {display: flex;justify-content: space-between;align-items: center;padding-left: 10px;background: #fff;border: 1.5px solid #222;cursor: pointer;font-size: 14px;font-weight: 500;transition: all 0.2s;}
#PopupVariants-{{ section.id }} .custom-select:hover .select-trigger {border-color: #000;}
/* Focus state when dropdown is open */
#PopupVariants-{{ section.id }}.custom-select.open .select-trigger {border-color: #000;box-shadow: 0 0 0 3px rgba(0,0,0,0.08);}
/* Arrow icon container - separated with left border per design */
#PopupVariants-{{ section.id }} .select-trigger .icon-arrow {width:60px;height:40px;display: flex;justify-content: center;align-items: center;border-left: 1px solid #222;}
#PopupVariants-{{ section.id }} .select-trigger svg {transition: 0.5s;}
/* Rotate arrow when open */
#PopupVariants-{{ section.id }} .custom-select.open .select-trigger svg {transform: rotate(180deg);}
/* Dropdown list - hidden by default with opacity transition */
#PopupVariants-{{ section.id }} .select-options {position: absolute;left: 0;right: 0;background: #fff;border: 1px solid #222;box-shadow: 0 10px 30px rgba(0,0,0,0.1);z-index: 10;overflow: hidden;opacity: 0;pointer-events: none;transition: all 0.25s ease;}
/* Visible state */
#PopupVariants-{{ section.id }} .custom-select.open .select-options {opacity: 1;pointer-events: auto;}
/* Individual option item */
#PopupVariants-{{ section.id }} .select-option {padding: 5px;cursor: pointer;font-size: 14px;transition: all 0.15s;text-align: center;}
#PopupVariants-{{ section.id }} .select-option:hover {background: #f5f5f5;}
/* Selected state - inverted colors */
#PopupVariants-{{ section.id }} .select-option.selected {background: #000;color: #fff;}

/* Form inputs wrapper */
#PopupForm-{{ section.id }} .popup-form-inputs {display: flex;gap: 10px;}
/* Number input */
#PopupForm-{{ section.id }} input[type="number"] {width: 70px;border: 1px solid #000;padding: 10px;outline: none;}
/* Add to cart button */
#PopupForm-{{ section.id }} button[type="submit"] {cursor:pointer;flex:1; background:#000; color:#fff; border:none; padding:12px; font-weight:bold;}
#PopupForm-{{ section.id }} button[type="submit"]:disabled { cursor: not-allowed; opacity: 0.5;}
/* Message form */
#PopupMessage-{{ section.id }}.message-form {margin-top:10px; font-size:14px; display:none;}
</style>


<script>
  (function() {
  /**
 * Product Grid Quick View
 * - Wrapped in an IIFE and scoped by section.id, so the section can be
 *   added to a page multiple times without ID or state collisions.
 * - Variant lookup uses a Map built once per product open (O(1) per selection).
 * - Add to cart uses Shopify's AJAX Cart API (/cart/add.js) and refreshes the
 *   header cart icon through the Section Rendering API (no page reload).
 * - Promotion: Black + Medium variants auto-add the "Dark Winter Jacket".
 */
  const sectionRoot = document.getElementById('product-grid-{{ section.id }}');
  if (!sectionRoot) return;

  // Cache static popup DOM nodes - prevents repeated querySelector on each open
  const overlay = document.getElementById('PopupOverlay-{{ section.id }}');
  const popupImage = document.getElementById('PopupImage-{{ section.id }}');
  const popupTitle = document.getElementById('PopupTitle-{{ section.id }}');
  const popupPrice = document.getElementById('PopupPrice-{{ section.id }}');
  const popupDesc = document.getElementById('PopupDesc-{{ section.id }}');
  const variantsWrap = document.getElementById('PopupVariants-{{ section.id }}');
  const variantInput = document.getElementById('PopupVariantId-{{ section.id }}');
  const popupForm = document.getElementById('PopupForm-{{ section.id }}');
  const popupMessage = document.getElementById('PopupMessage-{{ section.id }}');
  const closeBtn = sectionRoot.querySelector('.popup-close');

  // ---- State ----
let selectedOptions = [];    // Option values in product order, e.g. ['Black', 'Medium']
let softJacket = null;       // Cross-sell product, parsed from #SoftJacketJson
let matchedVariant = null;   // Variant matching the current selection (null until complete)
let currentProductData = null; // Data of the product shown in the popup
let lockClose = false;       // True while an add-to-cart request is in flight
  /**
    * Converts any CSS color name to HEX for reliable rendering
    * Handles edge cases like "Light Blue" -> "#add8e6"
    * Returns fallback #ccc if color name is invalid/custom like "Heather Grey"
  **/
  // Cache canvas context for performance - reuse instead of creating on every color
  const ctx = document.createElement('canvas').getContext('2d');
  function colorNameToHex(colorName) {
  // 1. Create offscreen canvas to let browser parse the color
  ctx.fillStyle = colorName.toLowerCase();
  // If browser couldn't parse it, fillStyle stays #000000 or original
  // We check with CSS.supports to be sure
  if (!CSS.supports('color', colorName)) {
    // Try with spaces removed - "Light Blue" -> "lightblue"
    const noSpace = colorName.toLowerCase().replace(/\s+/g, '');
    if (CSS.supports('color', noSpace)) {
      ctx.fillStyle = noSpace;
    } else {
      return '#cccccc'; // Fallback for custom names like "Heather Grey"
    }
  }
  
  // ctx.fillStyle always returns normalized hex/rgb - e.g. "black" -> "#000000"
  return ctx.fillStyle;
}

  // Parse the cross-sell product once. A parse failure must not break the quick view,
// so it only logs a warning and the promotion is skipped.
  try {
    const softJacketEl = document.getElementById('SoftJacketJson');
    if (softJacketEl) {
      softJacket = JSON.parse(softJacketEl.textContent);
    }
  }  catch(e) { console.warn('SoftJacket parse failed', e); }

  // Global handler to close custom selects when clicking outside
  document.addEventListener('click', (e) => {
    document.querySelectorAll('.custom-select').forEach(s => {
      if (!s.contains(e.target)) s.classList.remove('open');
    });
  });

  // Open popup on + button click
  sectionRoot.querySelectorAll('.circle-btn').forEach(btn => {
  btn.addEventListener('click', function() {
    const card = this.closest('.product-card');
    const productId = card.dataset.productId;
    const jsonEl = document.getElementById(`ProductJson-${productId}`);
    if(!jsonEl) return;
    
    const productData = JSON.parse(jsonEl.textContent);
    currentProductData = productData;
    /**
     * PERFORMANCE OPTIMIZATION:
     * Build variant Map once per product open: O(V * O) where V=variants, O=options
     * Lookup later is O(1) instead of O(V * O) with find+every on every click
     * Key format: "Color|Size" e.g. "Black|Medium" - order matches selectedOptions
     **/
    productData.variantMap = new Map();
      productData.variants.forEach(vr => {
        const key = [vr.option1, vr.option2, vr.option3].filter(Boolean).join('|');
        productData.variantMap.set(key, vr);
      });
    
    // Populate popup header
    popupTitle.textContent = productData.title;
    popupPrice.textContent = productData.price_formatted;
    popupImage.src = productData.image;
    popupDesc.innerHTML = productData.description;
    // Reset state for new product
    selectedOptions = new Array(productData.options.length).fill('');
    variantsWrap.innerHTML = '';
    matchedVariant = null;

    // Render dynamic option selectors based on product.options
    productData.options.forEach((opt) => {
      const option = document.createElement("div");
      const name = document.createElement('span');
      name.textContent = opt.name;
      option.appendChild(name);

    if (opt.name.toLowerCase() === "color") {
      // Color UI: Button group with active indicator sliding animation
      const containerValues = document.createElement("div");
      const activeElement = document.createElement("span")
      containerValues.className = "color";
      activeElement.className = "active-element"
      containerValues.appendChild(activeElement)
      option.appendChild(containerValues);
      variantsWrap.appendChild(option);

      opt.values.forEach((v) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.textContent = v;
      containerValues.appendChild(b);
      b.style.borderLeft = `5px solid ${colorNameToHex(v)}`; // Convert color name to HEX for consistent border color
      b.onclick = () => {
        containerValues.querySelectorAll('button').forEach(x => x.classList.remove("active"));
        b.classList.add("active");
        activeElement.style.left = b.offsetLeft + 'px';
        activeElement.style.width = b.offsetWidth + 'px';
        activeElement.style.opacity = '1';
        selectedOptions[opt.position - 1] = v;
        updateMatchedVariant();
      };
    });
    } else {
      // Size / Other options UI: Custom select dropdown (Figma spec)
      const wrapper = document.createElement("div");
      wrapper.className = `custom-select ${opt.name.toLowerCase()}`;
      const trigger = document.createElement("div");
      trigger.className = "select-trigger";
      const targetSize = document.createElement("span");
      targetSize.textContent = `Choose your ${opt.name}`;
      const iconArrow = document.createElement("span")
      iconArrow.className = "icon-arrow"
      iconArrow.innerHTML = `<svg width="15" height="9" viewBox="0 0 15 9" fill="none"><path d="M1.06055 1.06067L7.06055 7.06067L13.0605 1.06067" stroke="black" stroke-width="1.5" stroke-linecap="square"/></svg>`
      trigger.append(targetSize, iconArrow)
      const optionsList = document.createElement("div");
      optionsList.className = "select-options";

  opt.values.forEach((v) => {
    const o = document.createElement('div');
    o.className = 'select-option';
    o.dataset.value = v;
    o.textContent = v;

    o.onclick = () => {
      targetSize.textContent = v;
      optionsList.querySelectorAll('.select-option').forEach(el => el.classList.remove('selected'));
      o.classList.add('selected');
      wrapper.classList.remove('open');
      selectedOptions[opt.position - 1] = v;
      updateMatchedVariant();
    };
    optionsList.appendChild(o);
  });

    trigger.onclick = () => wrapper.classList.toggle('open');
      wrapper.append(trigger, optionsList);
      option.appendChild(wrapper);
      variantsWrap.appendChild(option);}
});

      /**
      * Updates matched variant using HashMap O(1)
      * Also handles UI states: disabled, out of stock, select options prompt
      **/
    function updateMatchedVariant() {
      const addBtn = document.querySelector(`#PopupForm-{{ section.id }} button[type="submit"]`);
      // Prevent add until all options selected
      if (selectedOptions.some(v =>!v)) {
        variantInput.value = '';
        matchedVariant = null;
        addBtn.disabled = true;
        addBtn.textContent = 'Select options';
        return;
    }

    const selectedKey = selectedOptions.filter(Boolean).join('|');
    const matched = currentProductData.variantMap.get(selectedKey);

    if(matched) {
      variantInput.value = matched.id;
      matchedVariant = matched;
      addBtn.disabled =!matched.available;
      addBtn.textContent = matched.available? 'Add to Cart' : 'Out of stock';
    } else {
  variantInput.value = '';
  matchedVariant = null;
  addBtn.disabled = true;
  addBtn.textContent = 'Unavailable';
}
  }
    updateMatchedVariant();
    popupMessage.style.display = 'none';
    overlay.classList.add('show');
    document.body.style.overflow = 'hidden';
  });
});


  /**
  * Closes the popup and restores page scroll.
  * Ignored while lockClose is true, so the user cannot dismiss the popup (× button,
  * overlay click, Escape) in the middle of an add-to-cart request. This keeps the
  * success/error message and the button state tied to the product that was added.
  */
  function closePopup() {
    if (lockClose) return;
    overlay.classList.remove('show');
    document.body.style.overflow = 'auto';
    popupMessage.style.display = 'none';
  }
  closeBtn.addEventListener('click', closePopup);
  // Close when clicking outside popup content
  overlay.addEventListener('click', function(e) { if (e.target === overlay) closePopup(); });
    // Close on ESC key
  document.addEventListener('keydown', function(e) { if (e.key === 'Escape' && overlay.classList.contains('show')) closePopup(); });

  /**
  * Add to Cart handler
  * 1. Lock the popup and disable the button (prevents double submit and early close).
  * 2. Add the selected variant via /cart/add.js.
  * 3. Promotion: if the variant is Black + Medium, also add the Dark Winter Jacket.
  * 4. Refresh the header cart icon via the Section Rendering API (no reload).
  * 5. Show feedback, then auto-close after 1s and release the lock.
  * On failure the lock is released immediately so the user can retry or close.
 */
 if (popupForm) {
  popupForm.addEventListener('submit', async function (e) {
    e.preventDefault();
    // Guard against a second submit (e.g. pressing Enter in the quantity field)
    if (lockClose) return;
    const submitBtn = this.querySelector('[type="submit"]');
    const originalText = submitBtn.textContent;

    try {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Adding...';
      popupMessage.style.display = 'none';
      lockClose = true;
      overlay.querySelector('.popup-content').classList.add('locked');
      const title = (matchedVariant?.title || '').toLowerCase();
      const hasBlack = title.includes('black');
      const hasMedium = title.includes('medium') || title.split('/').some(s => s.trim() === 'm');

      // 1) Add main product
      const res = await fetch('/cart/add.js', { method: 'POST', body: new FormData(this) });
      if (!res.ok) throw new Error((await res.json()).description || 'Failed to add');

      // 2) Promotion: auto-add jacket for Black + Medium
      let jacketAdded = false;
      if (hasBlack && hasMedium && softJacket) {
        // Fallback: if no Black/Medium variant exists on the jacket, use its first variant
        const jVar = softJacket.variants.find(v => {
          const t = (v.title || '').toLowerCase();
          return t.includes('black') && (t.includes('medium') || t.split('/').some(s => s.trim() === 'm'));
        }) || softJacket.variants[0];

        if (jVar) {
          const jRes = await fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: jVar.id, quantity: 1 })
          });
          // Only report the jacket as added if its request actually succeeded
          // (e.g. it may be out of stock even though the main product was added)
          jacketAdded = jRes.ok;
        }
      }

      // 3) Refresh the cart icon. Kept in its own try/catch: a failed icon refresh
// must not show an error after the product was added successfully.
      try {
        const secs = await (await fetch(`${location.pathname}?sections=cart-icon-bubble`, { cache: 'no-store' })).json();
        const temp = document.createElement('div');
        temp.innerHTML = secs['cart-icon-bubble'] || '';
        const newBubble = temp.querySelector('#cart-icon-bubble') || temp.querySelector('.shopify-section');
        const oldBubble = document.getElementById('cart-icon-bubble');
        if (newBubble && oldBubble) oldBubble.innerHTML = newBubble.innerHTML;
      } catch (e) {
        console.warn('Cart icon refresh failed', e);
      }

      popupMessage.textContent = jacketAdded ? '✓ Added + Dark Winter Jacket auto-added!' : '✓ Added to cart!';
      popupMessage.style.display = 'block';
      popupMessage.style.color = 'green';
      submitBtn.textContent = '✓ Added';

      setTimeout(
        () => {
          // Release the lock and close the popup
          lockClose = false;
          overlay.querySelector('.popup-content').classList.remove('locked');
          closePopup();
        }
        , 1000);

    } catch (err) {
      console.error(err);
      // Always release the lock on failure so the user is never stuck in the popup
      lockClose = false;
      popupMessage.textContent = err.message || 'Error adding to cart';
      popupMessage.style.display = 'block';
      popupMessage.style.color = 'red';
      submitBtn.disabled = false;
      overlay.querySelector('.popup-content').classList.remove('locked');
      submitBtn.textContent = originalText;
    }
  });
}
})();
</script>


{% schema %}
{
  "name": "Product Grid",
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select product"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    { 
      "name": "Product Grid",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}